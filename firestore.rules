rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public/collaborative access for shared event management
    match /events/{eventId} {
      allow read, write: if true;
    }
    match /gifts/{giftId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
